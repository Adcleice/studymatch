{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": true
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "studymatch-self.vercel.app" }],
      "destination": "https://matchworking.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/waitlist", "destination": "/waitlist-matchworking.html" },
    { "source": "/sobre", "destination": "/sobre.html" },
    { "source": "/((?!api/|assets/|studymatch-logo\\.svg|studymatch-mark\\.svg|favicon\\.svg|icons\\.svg|manifest\\.webmanifest|sw\\.js|robots\\.txt|sitemap\\.xml|google81a263c6e88db3c0\\.html|sobre|sobre\\.html|social/|waitlist|waitlist-matchworking\\.html).*)", "destination": "/index.html" }
  ]
}
